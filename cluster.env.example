# === ThinkMorph Cluster Configuration ===
# Copy this file to cluster.env and fill in your cluster-specific values:
#   cp cluster.env.example cluster.env
#
# cluster.env is gitignored — never commit it.

# ── Cluster identifier (used in wandb run names, log prefixes) ──────────────
CLUSTER_NAME="mila"

# ── Python environment ──────────────────────────────────────────────────────
# Path to the venv activate script
VENV_PATH="/path/to/scratch/morph_env/bin/activate"

# ── CUDA module ─────────────────────────────────────────────────────────────
# Module name to load via `module load`. Leave empty if CUDA is already in PATH.
CUDA_MODULE="cuda/12.6.0"

# ── Project root ────────────────────────────────────────────────────────────
# Where ThinkMorph is cloned
SCRIPT_DIR="/path/to/ThinkMorph-BAGEL-release"

# ── Storage paths ───────────────────────────────────────────────────────────
# Fast scratch filesystem for data, outputs, and checkpoints
SCRATCH_ROOT="/path/to/scratch"

# Derived paths (built from SCRATCH_ROOT — adjust if your layout differs)
DATA_ROOT="${SCRATCH_ROOT}/VisualCoT/training_data"
OUTPUT_ROOT="${SCRATCH_ROOT}/VisualCoT/training_outputs"
CKPT_ROOT="${SCRATCH_ROOT}/VisualCoT/BAGEL_checkpoints"

# Where pretrained model weights live
MODEL_ROOT="/path/to/scratch/models"
BAGEL_MODEL_PATH="${MODEL_ROOT}/BAGEL-7B-MoT"

# ── Weights & Biases ───────────────────────────────────────────────────────
WANDB_MODE="offline"
WANDB_DIR="${SCRATCH_ROOT}/VisualCoT/wandb_logs"
WANDB_CACHE_DIR="${SCRATCH_ROOT}/.cache/wandb"

# ── GPU / SLURM resources ──────────────────────────────────────────────────
NUM_GPUS=4
GPU_TYPE="a100l"           # SLURM gres type (e.g. a100l, h200, leave empty if not needed)
MEM="0G"                   # SLURM --mem
CPUS_PER_TASK=16
EXCLUDE_NODES=""           # e.g. "cn-g[001-007,009-011]"
PARTITION=""               # e.g. "short-unkillable"

# ── PyTorch tuning ──────────────────────────────────────────────────────────
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

# ── Qwen / LLaMA-Factory (optional, only needed for Qwen training) ─────────
CONDA_INIT="/path/to/home/anaconda3/etc/profile.d/conda.sh"
CONDA_ENV_PATH="/path/to/scratch/conda_env/LLaMAFac"
LLAMA_FACTORY_DIR="/path/to/home/LLaMA-Factory"
CUDA_MODULE_QWEN="cuda/12.1.1"   # Qwen scripts use a different CUDA version
